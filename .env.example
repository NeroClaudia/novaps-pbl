# local | production
APP_ENV=local

# false untuk production
APP_DEBUG=true

APP_TIMEZONE=Asia/Jakarta


# --------------------------------------------------
# POSTGRESQL DATABASE
# --------------------------------------------------

# Gunakan detail koneksi dari Supabase Dashboard
# atau PostgreSQL lokal untuk development.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ps_rental
DB_USER=postgres
DB_PASSWORD=


# --------------------------------------------------
# SUPABASE STORAGE
# --------------------------------------------------

# Supabase project URL, tanpa trailing slash
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Secret key server-side, jangan gunakan di browser
# Jangan commit secret key sungguhan
SUPABASE_SECRET_KEY=

# Nama private storage bucket
SUPABASE_IDENTITY_BUCKET=identity
SUPABASE_PAYMENT_BUCKET=payment


# --------------------------------------------------
# SESSION
# --------------------------------------------------

# Session lifetime dalam detik
# 28800 = 8 jam
SESSION_LIFETIME=28800


# --------------------------------------------------
# CORS
# --------------------------------------------------

# Untuk SSR dengan frontend dan backend satu origin,
# biarkan kosong jika tidak perlu cross-origin.
#
# Untuk development terpisah:
# CORS_ALLOWED_ORIGINS=http://localhost:5500
#
# Untuk production, gunakan origin HTTPS yang tepat.

CORS_ALLOWED_ORIGINS=


# --------------------------------------------------
# BOOKING RULES
# --------------------------------------------------

# Maksimal booking aktif per customer
BOOKING_MAX_ACTIVE=2

# Batas waktu pembayaran QRIS awal (menit)
PAYMENT_WINDOW_MINUTES=5