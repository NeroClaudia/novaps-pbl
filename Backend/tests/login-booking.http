@baseUrl = http://localhost/playstation/backend/public/api
@startTime = 2026-12-05T10:00:00

@sessionId = b1hofufrakjtocvnlgslocadkd

POST {{baseUrl}}/bookings/create.php
Content-Type: application/json
Cookie: psm_session={{sessionId}}

{
  "start_time": "{{startTime}}",
  "payment_method": "QRIS",
  "items": [
    {
      "device_id": 1,
      "duration_days": 2
    }
  ]
}

### TEST 1 - Login customer berhasil
# Expected: 200 OK
# Jalankan ini terlebih dahulu.
# PhpStorm menyimpan cookie psm_session dari respons.

POST {{baseUrl}}/auth/login.php
Content-Type: application/json

{
  "phone": "081234567890",
  "password": "customer12345"
}


### TEST 2 - Checkout QRIS setelah login
# Expected: 201 Created
# Jalankan setelah TEST 1 berhasil.
# Gunakan cookie jar PhpStorm pada host yang sama.

POST {{baseUrl}}/bookings/create.php
Content-Type: application/json

{
  "start_time": "{{startTime}}",
  "payment_method": "QRIS",
  "items": [
    {
      "device_id": 1,
      "duration_days": 2
    }
  ]
}


### TEST 3 - Login password salah
# Expected: 401 INVALID_CREDENTIALS

POST {{baseUrl}}/auth/login.php
Content-Type: application/json

{
  "phone": "081234567890",
  "password": "passwordSalah123"
}


### TEST 4 - Login nomor tidak terdaftar
# Expected: 401 INVALID_CREDENTIALS

POST {{baseUrl}}/auth/login.php
Content-Type: application/json

{
  "phone": "089999999999",
  "password": "password123"
}


### TEST 5 - Format nomor HP salah
# Expected: 422 VALIDATION_ERROR

POST {{baseUrl}}/auth/login.php
Content-Type: application/json

{
  "phone": "12345",
  "password": "customer12345"
}


### TEST 6 - Password kosong
# Expected: 422 VALIDATION_ERROR

POST {{baseUrl}}/auth/login.php
Content-Type: application/json

{
  "phone": "081234567890",
  "password": ""
}


### TEST 7 - Nomor telepon format +62
# Expected: 200 OK jika password benar

POST {{baseUrl}}/auth/login.php
Content-Type: application/json

{
  "phone": "+6281234567890",
  "password": "customer12345"
}


### TEST 8 - Metode GET ditolak
# Expected: 405 METHOD_NOT_ALLOWED

GET {{baseUrl}}/auth/login.php
