
### Konfigurasi
@baseUrl = http://localhost/playstation/backend/public/api
@sessionId = 501r68bmvbkmgfkiv163fg3cds
@startTime = 2026-11-20T10:00:00

### Login customer
POST {{baseUrl}}/auth/login.php
Content-Type: application/json

{
  "phone": "083456789012",
  "password": "customer12345"
}

### TEST 1 - Berhasil membuat booking QRIS
# Expected: 201 Created
# Customer wajib login, profil lengkap, identitas terverifikasi

POST {{baseUrl}}/bookings/create.php
Content-Type: application/json
Cookie: PHPSESSID={{sessionId}}

{
  "start_time": "{{startTime}}",
  "payment_method": "QRIS",
  "items": [
    {
      "device_id": 1,
      "duration_days": 2
    }
  ]
}


### TEST 2 - Berhasil membuat booking Cash
# Expected: 201 Created
# payment.expires_at = null

POST {{baseUrl}}/bookings/create.php
Content-Type: application/json
Cookie: PHPSESSID={{sessionId}}

{
  "start_time": "{{startTime}}",
  "payment_method": "Cash",
  "items": [
    {
      "device_id": 3,
      "duration_days": 1
    }
  ]
}


### TEST 3 - Customer belum login
