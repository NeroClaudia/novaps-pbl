
### Konfigurasi
@baseUrl = http://localhost/playstation/backend/public/api
@bookingCode = E74DF362
@cashBookingCode = GANTI_KODE_BOOKING_CASH
@imagePath = C:/laragon/www/PlayStation/Backend/tests/bukti-uji.png

### TEST 1 - Login customer Budi
# Expected: 200 OK
# Jalankan sebelum menguji upload
# Gunakan cookie jar PhpStorm

POST {{baseUrl}}/auth/login.php
Content-Type: application/json

{
  "phone": "081234567890",
  "password": "customer12345"
}


### TEST 2 - Upload bukti QRIS berhasil
# Expected: 200 OK
# Booking QRIS wajib masih Pending dan belum expired

POST {{baseUrl}}/bookings/payment-proof.php
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="booking_code"

{{bookingCode}}
--WebAppBoundary
Content-Disposition: form-data; name="payment_proof"; filename="payment.jpg"
Content-Type: image/jpeg

< {{imagePath}}
--WebAppBoundary--


### TEST 3 - Upload bukti yang sama dua kali
# Expected: 409 INVALID_STATUS_TRANSITION
# Jalankan setelah TEST 2 berhasil

POST {{baseUrl}}/bookings/payment-proof.php
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="booking_code"

{{bookingCode}}
--WebAppBoundary
Content-Disposition: form-data; name="payment_proof"; filename="payment.jpg"
Content-Type: image/jpeg

< {{imagePath}}
--WebAppBoundary--


### TEST 4 - Booking code tidak ditemukan
# Expected: 404 NOT_FOUND

POST {{baseUrl}}/bookings/payment-proof.php
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="booking_code"

ZZZZ9999
--WebAppBoundary
Content-Disposition: form-data; name="payment_proof"; filename="payment.jpg"
Content-Type: image/jpeg

< {{imagePath}}
--WebAppBoundary--


### TEST 5 - Kode booking tidak valid
# Expected: 422 VALIDATION_ERROR

POST {{baseUrl}}/bookings/payment-proof.php
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="booking_code"

ABC
--WebAppBoundary
Content-Disposition: form-data; name="payment_proof"; filename="payment.jpg"
Content-Type: image/jpeg

< {{imagePath}}
--WebAppBoundary--


### TEST 6 - Tidak mengunggah file
# Expected: 422 VALIDATION_ERROR

POST {{baseUrl}}/bookings/payment-proof.php
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="booking_code"

{{bookingCode}}
--WebAppBoundary--


### TEST 7 - Upload bukti untuk pembayaran Cash
# Expected: 409 PAYMENT_PROOF_NOT_REQUIRED
# Gunakan booking Cash milik customer yang login

POST {{baseUrl}}/bookings/payment-proof.php
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="booking_code"

{{cashBookingCode}}
--WebAppBoundary
Content-Disposition: form-data; name="payment_proof"; filename="payment.jpg"
Content-Type: image/jpeg

< {{imagePath}}
--WebAppBoundary--


